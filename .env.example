# Set to "true" only for local development of the admin mockup. Never set in production.
VITE_ENABLE_ADMIN=

# ---- Supabase ----------------------------------------------------------------------------------
# Browser-safe (public) values. The site already uses these for sign-in and orders.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER SIDE ONLY. Never give these a VITE_ prefix: anything with that prefix is shipped to every visitor.
# Used by scripts/seed-catalog.mjs, the database migrations, and api/quote.js on Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
