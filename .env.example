# ---- Supabase ----------------------------------------------------------------------------------
# Browser-safe (public) values. The site already uses these for sign-in and orders.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER SIDE ONLY. Never give these a VITE_ prefix: anything with that prefix is shipped to every visitor.
# Used by scripts/seed-catalog.mjs, the database migrations, and api/quote.js on Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ---- Google sign-in (browser-safe) ---------------------------------------------------------------
# The Web client ID of the Google OAuth client that Supabase's Google provider uses. It turns on Google's personalized "Sign in"
# button and One Tap. Authorized JavaScript origins must list every site address (lovesblinds.com, www.lovesblinds.com, http://localhost:5173
# and the Vercel preview addresses). Leave empty and the buttons use the ordinary Google redirect sign-in.
VITE_GOOGLE_CLIENT_ID=
